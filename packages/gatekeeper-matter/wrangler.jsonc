{
  "name": "gatekeeper-matter",
  "main": ".wrangler/validate/src/index.ts",
  "build": {
    "command": "pnpm exec capnweb-validate build --out .wrangler/validate",
    "watch_dir": "src"
  },
  "compatibility_date": "2026-08-04",
  "compatibility_flags": ["allow_irrevocable_stub_storage", "nodejs_compat"],
  "rules": [
    { "type": "Text", "globs": ["**/*.txt", "**/*.svg"], "fallthrough": false },
    // WP-15: anydoc's WebAssembly module (Word, PowerPoint, Excel, OpenDocument, RTF, EPUB, CSV,
    // text-layer PDFs to Markdown in the worker, no model) is imported as a compiled module.
    { "type": "CompiledWasm", "globs": ["**/*.wasm"], "fallthrough": false }
  ],
  "migrations": [
    { "tag": "v0", "new_sqlite_classes": ["MatterAccount", "MatterGatekeeper", "MatterStore"] },
    { "tag": "v1", "new_sqlite_classes": ["FirmMattersGatekeeper"] },
    { "tag": "v2", "new_sqlite_classes": ["FirmIndex"] }
  ],
  "durable_objects": {
    "bindings": [
      { "name": "MATTER_STORE", "class_name": "MatterStore" },
      // The firm's registry: ownership, holds, lane models (see firm-index.ts).
      { "name": "FIRM_INDEX", "class_name": "FirmIndex" }
    ]
  },
  "r2_buckets": [{ "binding": "MATTER_FILES", "bucket_name": "legal-os-matters" }],
  "queues": {
    "producers": [{ "binding": "INGEST_QUEUE", "queue": "legal-os-ingest" }],
    "consumers": [{ "queue": "legal-os-ingest", "max_batch_size": 1, "max_retries": 6, "max_concurrency": 20 }]
  },
  "ai": { "binding": "AI" },
  // WP-13: the daily docket sweep (13:00 UTC, before the US workday): derived windows, RFE clocks
  // and reminders 30/14/7/1/0 days out, once each, waking the counsel on every matter that has one.
  "triggers": { "crons": ["0 13 * * *"] },
  // The firm's method (playbooks, rules) for readiness, the knowledge build and the letter's order.
  // deploy.ts points this at the deployed firm worker; the dev name is the package's.
  "services": [{ "binding": "FIRM_LIBRARY", "service": "custom-gatekeeper", "entrypoint": "FirmLibraryApi" }],
  "vectorize": [{ "binding": "FACT_VECTORS", "index_name": "legal-os-facts" }],
  "vars": {
    // The reading lane runs on Workers AI by default. Set READER_PROVIDER to "openrouter" (plus the
    // OPENROUTER_API_KEY secret) to read on OpenRouter with UNDERSTAND_MODEL instead.
    "READER_PROVIDER": "workers-ai",
    "READER_MODEL": "@cf/deepseek-ai/deepseek-v4-pro-0813",
    // The case knowledge lane: fast JSON over facts; the deep reader timed out here.
    "KNOWLEDGE_MODEL": "@cf/meta/llama-4-scout-17b-16e-instruct",
    "UNDERSTAND_MODEL": "deepseek/deepseek-v4-pro",
    // Public origin for portal and file links (deploy.ts sets it); empty means relative paths.
    "PUBLIC_BASE_URL": "",
    // PORTAL_SECRET (extra entropy for signed file links) is a secret: `wrangler secret put PORTAL_SECRET --name legal-os-matter`.
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "logs": { "invocation_logs": false }
  }
}
